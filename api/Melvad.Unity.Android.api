// Native Android bridge ABI, Java signatures only.
// Implementation is distributed in Plugins/Android/MelvadUnityBridge.aar.

package com.melvad.unity;

public final class RewardedBridge {
    public RewardedBridge(android.app.Activity activity, String json, MelvadUnityListener listener) throws org.json.JSONException;
    public void show();
    public void setPaused(boolean paused);
    public void destroy();
}

public interface MelvadUnityListener {
    public void onEvent(String json);
}
