// Selected public API signatures for Melvad Android Ads SDK 1.0.3.
// Reference metadata only. Implementations are distributed in the binary AAR.

package com.melvad.sdk

public class MelvadSdk {
    public constructor(context: android.content.Context, configuration: MelvadConfiguration = MelvadConfiguration())
    public val configuration: MelvadConfiguration
    public fun createAdView(context: android.content.Context): MelvadAdView
}

public class MelvadAdView : android.widget.FrameLayout {
    public var listener: MelvadAdListener?
    public val state: MelvadAdState
    public val isReady: Boolean
    public val isExpanded: Boolean
    public val isAdBreakActive: Boolean
    public fun loadAd(request: MelvadAdRequest)
    public fun loadAd(request: MelvadAdRequest, rewardUserId: String)
    public fun prepareAd(request: MelvadAdRequest)
    public fun prepareAd(request: MelvadAdRequest, rewardUserId: String)
    public fun show(): Boolean
    public fun collapse()
    public fun retryVideo()
    public fun setVideoMuted(muted: Boolean)
    public fun startContent()
    public fun updateContent(positionMillis: Long, durationMillis: Long, playing: Boolean, ended: Boolean = false)
    public fun pause()
    public fun resume()
    public fun destroy()
}

public interface MelvadAdListener {
    public fun onStateChanged(view: MelvadAdView, state: MelvadAdState)
    public fun onLoaded(view: MelvadAdView)
    public fun onImpression(view: MelvadAdView)
    public fun onClicked(view: MelvadAdView)
    public fun onExpanded(view: MelvadAdView)
    public fun onCollapsed(view: MelvadAdView)
    public fun onVideoEvent(view: MelvadAdView, event: String)
    public fun onVideoStateChanged(view: MelvadAdView, state: MelvadVideoState)
    public fun onContentPauseRequested(view: MelvadAdView)
    public fun onContentResumeRequested(view: MelvadAdView)
    public fun onAdBreakStarted(view: MelvadAdView, breakId: String)
    public fun onAdBreakEnded(view: MelvadAdView, breakId: String)
    public fun onVideoError(view: MelvadAdView, error: MelvadAdError)
    public fun onRewardEarned(view: MelvadAdView)
    public fun onError(view: MelvadAdView, error: MelvadAdError)
}

public enum class MelvadAdState { IDLE, LOADING, LOADED, NO_FILL, FAILED, CLOSED, DESTROYED }
